# AI Call Summarizer - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=AI Call Summarizer
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/call_assistant

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Object Storage (S3-compatible for WAV files)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=call-recordings

# AI Services
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Redis (for background task queue)
REDIS_URL=redis://localhost:6379/0

# VoIP/SIP Configuration
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
